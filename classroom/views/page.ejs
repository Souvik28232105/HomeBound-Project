<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% if(success && success.length) { %>
        <p style="color: green;"><%= success %></p>
    <% } %>

    <% if(error && error.length) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <h1>Hello, <%= name %></h1>
</body>
</html>