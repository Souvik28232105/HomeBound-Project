# Local development configuration. Do not commit a real .env file.
ATLASDB_URL=mongodb://127.0.0.1:27017/homebound
# SOURCE_DB_URL=mongodb://127.0.0.1:27017/wanderlust
SECRET=replace-with-a-long-random-secret
MAP_TOKEN=your-mapbox-token
# Use local file storage by default. Set to "cloudinary" only after configuring
# valid Cloudinary credentials.
UPLOAD_STORAGE=local

# Required only for the guarded maintenance scripts.
# TARGET_USERNAME=example-user
# NEW_PASSWORD=choose-a-strong-temporary-password
# CONFIRM_MAKE_OWNER=yes
# CONFIRM_PASSWORD_RESET=yes
# CONFIRM_DATABASE_MIGRATION=yes
